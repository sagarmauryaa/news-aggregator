PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/news-aggregator
# Required. At least 32 characters. The server refuses to start or sign tokens without it.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
NEWS_API_KEY=your_newsapi_org_key
# Optional override when pointing the client at a local stand-in for NewsAPI
# NEWS_API_BASE_URL=https://newsapi.org/v2/everything
# How long a preference feed stays cached, in seconds
CACHE_TTL_SECONDS=3600
# How long an individual article stays resolvable for read/favorite, in seconds
ARTICLE_CACHE_TTL_SECONDS=86400
# How often the background job refreshes cached preference feeds and drops expired cache entries, in milliseconds
CACHE_REFRESH_MS=1800000
# Maximum cached preference/search feeds and individual articles. Oldest entries are evicted past these limits.
CACHE_MAX_FEEDS=100
CACHE_MAX_ARTICLES=1000
# Optional. Test runs ignore MONGODB_URI and use this database when it is set. The database name must contain "test".
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/news-aggregator-test
